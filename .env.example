# Smriti Sathi backend environment template.
# These values belong only on the proxy server; never use a VITE_ prefix.
GROQ_API_KEY=replace_on_server_only
SARVAM_API_KEY=replace_on_server_only
AZURE_SPEECH_KEY=replace_on_server_only
AZURE_SPEECH_REGION=eastus

# Optional comma-separated origins allowed to call the proxy.
AI_PROXY_ORIGINS=https://your-web-origin.example,http://localhost:5173,http://127.0.0.1:5173,capacitor://localhost,http://localhost

# Non-secret only; required as an absolute HTTPS URL for Capacitor builds.
VITE_AI_PROXY_URL=
# Optional comma-separated fallback list; VITE_AI_PROXY_URL remains supported.
VITE_AI_PROXY_URLS=
